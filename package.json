{
  "name": "snap-ratio",
  "displayName": "Snap Ratio",
  "version": "1.1.0",
  "description": "Capture perfect fixed-ratio frames, auto-resize, compress, and download polished thumbnails in one click.",
  "author": "Mohammad Ali <itsproali@gmail.com>",
  "homepage": "https://github.com/itsproali/snap-ratio",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "build:firefox": "plasmo build --target=firefox-mv3",
    "package": "plasmo package",
    "package:firefox": "plasmo package --target=firefox-mv3",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@plasmohq/storage": "1.15.0",
    "plasmo": "0.90.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-rnd": "10.5.3"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/chrome": "0.2.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.24",
    "postcss": "8.5.25",
    "prettier": "3.9.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "manifest": {
    "name": "Snap Ratio — Fixed-Ratio Screenshot Capture",
    "short_name": "Snap Ratio",
    "minimum_chrome_version": "116",
    "permissions": [
      "activeTab",
      "storage",
      "downloads"
    ],
    "host_permissions": [
      "https://*/*",
      "http://*/*"
    ],
    "commands": {
      "start-capture": {
        "suggested_key": {
          "default": "Alt+Shift+S",
          "mac": "Alt+Shift+S"
        },
        "description": "Start a Snap Ratio capture on the current tab"
      }
    }
  }
}
